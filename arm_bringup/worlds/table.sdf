<?xml version="1.0"?>
<!-- Table and box match the constants in arm_commander/src/pick_place.cpp -->
<sdf version="1.9">
  <world name="table_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.65 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.8 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.8 0.15</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box">
      <pose>0.6 -0.2 0.2 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000967</ixx><iyy>0.0000967</iyy><izz>0.0000267</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Depth camera on a stand across the table, looking down at it.
         Pose must match the camera_link static TF in arm_gz.launch.xml -->
    <model name="camera">
      <static>true</static>
      <pose>1.8 0 1.8 0 0.89 3.14159</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.05 0.1 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <topic>camera</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- Stand sits just behind the camera and below it, so it stays out of the view -->
    <model name="camera_stand">
      <static>true</static>
      <pose>1.86 0 0.87 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.015</radius><length>1.74</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <!-- Bracket from the stand top to the back of the camera (behind the lens, out of view) -->
        <visual name="bracket">
          <pose>-0.015 0 0.89 0 0 0</pose>
          <geometry><box><size>0.07 0.03 0.05</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
