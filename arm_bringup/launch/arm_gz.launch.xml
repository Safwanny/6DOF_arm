<launch>
    <let name="urdf_path"
         value="$(find-pkg-share arm_description)/urdf/robot_arm.urdf.xacro"/>
    <let name="world_path"
         value="$(find-pkg-share arm_bringup)/worlds/table.sdf"/>
    <let name="rviz_config_path"
         value="$(find-pkg-share arm_bringup)/config/arm_gz.rviz"/>

    <!-- Every node below (including move_group) runs on Gazebo's clock -->
    <set_parameter name="use_sim_time" value="true"/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r $(var world_path)"/>
        <!-- Closing Gazebo, RViz or the camera window shuts everything down -->
        <arg name="on_exit_shutdown" value="true"/>
    </include>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path) sim:=true')" />
    </node>

    <!-- The gz_ros2_control plugin in the URDF starts the controller_manager -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name robot_arm" />

    <!-- /model/cube_N/pose: where each cube really is (published by the cube, see spawn_cubes.py);
         the ground truth for checking the camera, and what packer.py uses with perception:=false -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge"
          args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock
                /camera/image@sensor_msgs/msg/Image[gz.msgs.Image
                /camera/depth_image@sensor_msgs/msg/Image[gz.msgs.Image
                /camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo
                /camera/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
                /model/cube_0/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
                /model/cube_1/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
                /model/cube_2/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
                /model/cube_3/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
                /model/cube_4/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
                /model/cube_5/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V" />

    <!-- Same pose as the camera model in table.sdf -->
    <node pkg="tf2_ros" exec="static_transform_publisher"
          args="--x 1.8 --y 0 --z 1.8 --roll 0 --pitch 0.89 --yaw 3.14159
                --frame-id base_link --child-frame-id camera_link" />

    <node pkg="controller_manager" exec="spawner"
          args="joint_state_broadcaster --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
          args="arm_controller --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
          args="gripper_controller --controller-manager-timeout 60" />

    <include file="$(find-pkg-share arm_moveit_config)/launch/move_group.launch.py" />

    <!-- Finds the red cubes in /camera/points and publishes them on /detected_cubes -->
    <node pkg="arm_bringup" exec="cube_detector.py" />

    <!-- Colour and depth images side by side in their own window -->
    <node pkg="arm_bringup" exec="camera_view.py" on_exit="shutdown" />

    <!-- RViz shows the robot, planning scene and camera point cloud -->
    <node pkg="rviz2" exec="rviz2" output="screen" on_exit="shutdown"
          args="-d $(var rviz_config_path)" />
</launch>
