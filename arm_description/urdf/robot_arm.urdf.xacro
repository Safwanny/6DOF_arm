<?xml version="1.0"?>
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- sim:=true runs on Gazebo (gz_ros2_control); default is mock hardware -->
    <xacro:arg name="sim" default="false" />

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="arm.xacro" />
    <xacro:include filename="gripper.xacro" />
    <xacro:include filename="robot_arm.ros2_control.xacro" />

    <joint name="gripper_base_joint" type="fixed">
        <parent link="tool_link" />
        <child link="gripper_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <xacro:if value="$(arg sim)">
        <!-- Bolt the base to the ground (sim only, MoveIt adds its own world joint from the SRDF) -->
        <link name="world" />
        <joint name="world_base_joint" type="fixed">
            <parent link="world" />
            <child link="base_link" />
        </joint>

        <!-- Grippy fingers so the box doesn't slip out -->
        <gazebo reference="gripper_left_finger_link">
            <mu1>1.5</mu1>
            <mu2>1.5</mu2>
        </gazebo>
        <gazebo reference="gripper_right_finger_link">
            <mu1>1.5</mu1>
            <mu2>1.5</mu2>
        </gazebo>

        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find arm_bringup)/config/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>