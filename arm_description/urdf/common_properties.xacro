<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="dark_green">
        <color rgba="0 0.4 0 1" />
    </material>

    <material name="light_green">
        <color rgba="0 0.6 0 1" />
    </material>

    <!-- Solid box / cylinder (axis along z) inertia, centred at xyz -->
    <xacro:macro name="box_inertia" params="m x y z xyz">
        <inertial>
            <origin xyz="${xyz}" rpy="0 0 0" />
            <mass value="${m}" />
            <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
                     iyy="${m*(x*x+z*z)/12}" iyz="0"
                     izz="${m*(x*x+y*y)/12}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l xyz">
        <inertial>
            <origin xyz="${xyz}" rpy="0 0 0" />
            <mass value="${m}" />
            <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
                     iyy="${m*(3*r*r+l*l)/12}" iyz="0"
                     izz="${m*r*r/2}" />
        </inertial>
    </xacro:macro>


</robot>